{
  "name": "helium-max",
  "description": "Local-first, bring-your-own-key AI browser extension for Helium (Manifest V3).",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:e2e && playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "postinstall": "wxt prepare",
    "screenshots": "pnpm build:e2e && SCREENSHOTS=1 playwright test e2e/screenshots"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "packageManager": "pnpm@12.15.0"
}
